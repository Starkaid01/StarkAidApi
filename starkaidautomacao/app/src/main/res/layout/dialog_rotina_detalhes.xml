<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloRotina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detalhes da Rotina"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gatilhos (Triggers):"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvGatilhos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Às 08:00\n• Quando eu disser 'Bom dia'"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ações (Tasks):"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvAcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Pergunta as horas\n2. Pergunta a previsão do tempo"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnFechar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fechar" />

</LinearLayout>
