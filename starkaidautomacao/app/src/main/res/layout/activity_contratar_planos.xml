<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.ContratarPlanosActivity">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assinar StarkAid Premium"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Plano único: StarkAid Premium (nível 2).\n• 4500 tokens/semana\n• Agendamentos ilimitados\n• Anúncios removidos\n• +50 StarkCoins todo mês após renovação\nValor: R$ 10,00/mês."
        android:textSize="15sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/planosRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        android:layout_marginTop="24dp" />

    <!-- Grid de planos usando ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/planosGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description">

        <!-- Nível 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNivel2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.95">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StarkAid Premium"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="R$ 10,00 / mês"
                    android:textColor="@android:color/holo_green_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• 4500 tokens/semana\n• Agendamentos ilimitados\n• Anúncios removidos\n• +50 StarkCoins após cada renovação"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnNivel2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Assinar StarkAid Premium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nível 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNivel3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <!-- Nível 4 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNivel4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <!-- Nível 5 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNivel5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <!-- Nível 6 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNivel6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <!-- Nível 7 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNivel7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
