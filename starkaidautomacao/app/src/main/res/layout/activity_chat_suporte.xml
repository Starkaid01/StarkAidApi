<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b141a"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Header / Connection Controls -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1f2c34"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#00a884"
                android:text="Conectar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#ef5350"
                android:enabled="false"
                android:text="Desconectar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Desconectado"
            android:textColor="#8696a0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/queueStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202c33"
            android:gravity="center"
            android:padding="4dp"
            android:text=""
            android:textColor="#00a884"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Messages Area -->
    <ScrollView
        android:id="@+id/messageScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/inputAreaContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer">

        <LinearLayout
            android:id="@+id/chatMessagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- Formulario Limite (Hidden by default) -->
    <ScrollView
        android:id="@+id/formulario_limite_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0b141a"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Formulário de Suporte"
                android:textColor="#e9edef"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Descreva seu problema para nossa equipe:"
                android:textColor="#8696a0" />

            <EditText
                android:id="@+id/formulario_mensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_input"
                android:gravity="top"
                android:hint="Digite aqui..."
                android:inputType="textMultiLine"
                android:minLines="6"
                android:padding="12dp"
                android:textColor="#e9edef"
                android:textColorHint="#8696a0" />

            <Button
                android:id="@+id/btnEnviarFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#00a884"
                android:text="Enviar para Suporte"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>

    <!-- Input Area -->
    <LinearLayout
        android:id="@+id/inputAreaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1f2c34"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="Mensagem"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:padding="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#e9edef"
            android:textColorHint="#8696a0" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00a884"
            android:text=">"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:gravity="center"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
