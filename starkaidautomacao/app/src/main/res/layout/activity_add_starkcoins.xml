<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.AddStarkcoinsActivity">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adicionar Fundos - StarkCoins"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="50dp" />

    <TextView
        android:id="@+id/labelSuggested"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha um pacote:"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView"
        android:layout_marginTop="40dp" />

    <LinearLayout
        android:id="@+id/packagesLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelSuggested">

        <Button
            android:id="@+id/btnValue10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5 StarkCoins — R$ 4,90"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnValue25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15 StarkCoins — R$ 9,90"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnValue50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="50 StarkCoins — R$ 19,90"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnValue100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="120 StarkCoins — R$ 39,90"
            android:textSize="16sp"
            android:padding="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
