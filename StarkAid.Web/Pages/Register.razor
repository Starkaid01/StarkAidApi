@page "/register"
@using StarkAid.Web.DTOs
@using StarkAid.Web.Services
@inject ApiService ApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<h3>Registrar</h3>

<input @bind="name" placeholder="Nome" />
<input @bind="email" placeholder="Email" />
<input type="password" @bind="password" placeholder="Senha" />
<button @onclick="HandleRegister">Registrar</button>

@code {
    private string name = "";
    private string email = "";
    private string password = "";

    private async Task HandleRegister()
    {
        var registerDto = new UserRegisterDto
        {
            Name = name,
            Email = email,
            Password = password,
            Origem = "web",
            Estado = "Minas Gerais",
            Cidade = "Sao Joao Del Rei",
            Bairro = "Bomfin"
        };

        var auth = await ApiService.RegisterAsync(registerDto);

        if (auth == null)
            return;

        await JS.InvokeVoidAsync("localStorage.setItem", "token", auth.Token);
        await JS.InvokeVoidAsync("localStorage.setItem", "apiKey", auth.User?.ApiKey);

        NavigationManager.NavigateTo("/dashboard");
    }
}