@page "/register"
@using StarkAid.Web.DTOs
@using StarkAid.Web.Services
@inject ApiService ApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<h3>Registrar</h3>

<input @bind="name" placeholder="Nome" class="form-control" />
<input @bind="email" placeholder="Email" class="form-control" />
<input type="password" @bind="password" placeholder="Senha" class="form-control" />
<button @onclick="HandleRegister" class="btn btn-primary">Registrar</button>

@code {
    private string name = "";
    private string email = "";
    private string password = "";

    private async Task HandleRegister()
    {
        var registerDto = new UserRegisterDto
        {
            Name = name,
            Email = email,
            Password = password,
            Origem = "web",
            Estado = "Minas Gerais",
            Cidade = "Sao Joao Del Rei",
            Bairro = "Bomfin"
        };

        var auth = await ApiService.RegisterAsync(registerDto);

        if (auth == null) return;

        await JS.InvokeVoidAsync("localStorage.setItem", "token", auth.Token);
        await JS.InvokeVoidAsync("localStorage.setItem", "apiKey", auth.User?.ApiKey);

        NavigationManager.NavigateTo("/dashboard");
    }
}

<style>
    .form-control {
        width: 100%;
        margin-bottom: 1rem;
        padding: 0.5rem;
    }

    .btn-primary {
        background: #007bff;
        color: white;
        padding: 0.5rem 1rem;
    }
</style>