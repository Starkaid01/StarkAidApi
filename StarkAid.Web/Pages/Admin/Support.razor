    private async Task ExecuteAction(Task<bool> action)
    {
        if (selectedUser == null) return;
        var result = await action;
        if(result) 
        {
             ToastService.ShowSuccess("Ação executada com sucesso!");
        }
        else 
        {
             ToastService.ShowError("Erro ao executar ação.");
        }
    }
