@page "/starkcoins"
@using StarkAid.Web.Services
@inject ApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h3>Starkcoins</h3>

<div class="stark-grid">
    <div class="card stark-card text-center">
        <div class="coin-icon">💰</div>
        <h4>5 Starkcoins</h4>
        <p class="mb-4">Valor: <strong>R$ 4,90</strong></p>
        <button @onclick="() => Comprar(5)" class="btn btn-primary w-100">Comprar Agora</button>
    </div>
    <div class="card stark-card text-center">
        <div class="coin-icon">💎</div>
        <h4>15 Starkcoins</h4>
        <p class="mb-4">Valor: <strong>R$ 9,90</strong></p>
        <button @onclick="() => Comprar(15)" class="btn btn-primary w-100">Comprar Agora</button>
    </div>
    <div class="card stark-card text-center">
        <div class="coin-icon">🌟</div>
        <h4>50 Starkcoins</h4>
        <p class="mb-4">Valor: <strong>R$ 19,90</strong></p>
        <button @onclick="() => Comprar(50)" class="btn btn-primary w-100">Comprar Agora</button>
    </div>
    <div class="card stark-card text-center">
        <div class="coin-icon">👑</div>
        <h4>120 Starkcoins</h4>
        <p class="mb-4">Valor: <strong>R$ 39,90</strong></p>
        <button @onclick="() => Comprar(120)" class="btn btn-primary w-100">Comprar Agora</button>
    </div>
</div>

@code {
    private async Task Comprar(int coins)
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        var apiKey = await JS.InvokeAsync<string>("localStorage.getItem", "apiKey");
        var checkout = await ApiService.AddFundsAsync(coins, token, apiKey);
        if (checkout != null) Navigation.NavigateTo(checkout.CheckoutUrl);
    }
}

<style>
    .stark-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .stark-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        min-height: 220px;
    }

    .coin-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        text-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
    }
</style>
