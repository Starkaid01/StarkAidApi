@page "/solutions"
@layout PublicLayout

<div class="solutions-hero">
    <div class="container">
        <h1 class="page-title">StarkAid <span class="gradient-text">Solutions</span></h1>
        <p class="page-subtitle">Soluções completas para transformar seu negócio</p>
    </div>
</div>

<section class="solutions-main">
    <div class="container">
        <div class="solutions-cards">
            <div class="product-card active">
                <div class="card-header">
                    <div class="card-icon">🏠</div>
                    <h2>StarkAid Automação</h2>
                </div>
                <p class="card-description">
                    Plataforma completa de automação residencial e IoT com controle inteligente de dispositivos
                </p>
                <a href="/solutions/automacao" class="card-button">Saiba Mais →</a>
            </div>

            <div class="product-card coming-soon">
                <div class="card-header">
                    <div class="card-icon">💬</div>
                    <h2>StarkAid WhatsApp Bot</h2>
                </div>
                <p class="card-description">
                    Automação de atendimento via WhatsApp com inteligência artificial
                </p>
                <div class="coming-soon-badge">Em Breve</div>
            </div>

            <div class="product-card coming-soon">
                <div class="card-header">
                    <div class="card-icon">🎓</div>
                    <h2>StarkAid School</h2>
                </div>
                <p class="card-description">
                    Plataforma de ensino e cursos de programação e tecnologia
                </p>
                <div class="coming-soon-badge">Em Breve</div>
            </div>
        </div>
    </div>
</section>

