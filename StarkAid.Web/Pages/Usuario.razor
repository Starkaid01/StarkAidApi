@page "/usuario"
@using StarkAid.Web.Dtos
@using StarkAid.Web.Services
@inject ApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<h3>Configuração do Usuário</h3>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="dashboard-card">
            @if (isLoading)
            {
                <div class="loading-container">
                    <div class="spinner"></div>
                    <p>Carregando perfil...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> @errorMessage
                    <div class="mt-3">
                        <button class="btn btn-outline-danger" @onclick="OnInitializedAsync">Tentar Novamente</button>
                    </div>
                </div>
            }
            else if (user != null)
            {
                <EditForm Model="@user" OnValidSubmit="UpdateProfile">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group mb-4">
                        <label>Nome Completo</label>
                        <InputText @bind-Value="user.Name" class="form-control" placeholder="Seu nome" />
                    </div>
                    <div class="form-group mb-4">
                        <label>Email</label>
                        <InputText @bind-Value="user.Email" class="form-control" disabled />
                        <small class="text-muted">O email não pode ser alterado.</small>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="form-group">
                                <label>Estado</label>
                                <InputText @bind-Value="user.Estado" class="form-control" placeholder="UF" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="form-group">
                                <label>Cidade</label>
                                <InputText @bind-Value="user.Cidade" class="form-control" placeholder="Sua cidade" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label>Bairro</label>
                        <InputText @bind-Value="user.Bairro" class="form-control" placeholder="Seu bairro" />
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-save"></i> Salvar Alterações
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private UserMeDto? user;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            var apiKey = await JS.InvokeAsync<string>("localStorage.getItem", "apiKey");

            if (string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            user = await ApiService.GetMeAsync(token, apiKey);

            if (user == null)
            {
                errorMessage = "Não foi possível carregar os dados do perfil. Por favor, tente fazer login novamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar perfil: {ex.Message}";
            await JS.InvokeVoidAsync("console.error", errorMessage);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateProfile()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            var apiKey = await JS.InvokeAsync<string>("localStorage.getItem", "apiKey");
            var message = await ApiService.UpdateProfileAsync(user!, token, apiKey);
            await JS.InvokeVoidAsync("alert", message);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Erro ao salvar: " + ex.Message);
        }
    }
}

<style>
    .form-group {
        margin-bottom: 1rem;
    }
</style>