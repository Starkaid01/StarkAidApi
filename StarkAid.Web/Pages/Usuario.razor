@page "/usuario"
@using StarkAid.Web.Dtos
@using StarkAid.Web.Services
@inject ApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<h3>Configuração do Usuário</h3>

@if (user == null)
{
    <p>Carregando...</p>
}
else
{
    <EditForm Model="@user" OnValidSubmit="UpdateProfile">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Nome</label>
            <InputText @bind-Value="user.Name" class="form-control" />
        </div>
        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="user.Email" class="form-control" disabled />
        </div>
        <div class="form-group">
            <label>Estado</label>
            <InputText @bind-Value="user.Estado" class="form-control" />
        </div>
        <div class="form-group">
            <label>Cidade</label>
            <InputText @bind-Value="user.Cidade" class="form-control" />
        </div>
        <div class="form-group">
            <label>Bairro</label>
            <InputText @bind-Value="user.Bairro" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </EditForm>
}

@code {
    private UserMeDto? user;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        var apiKey = await JS.InvokeAsync<string>("localStorage.getItem", "apiKey");
        if (string.IsNullOrEmpty(token)) NavigationManager.NavigateTo("/login");

        user = await ApiService.GetMeAsync(token, apiKey);
    }

    private async Task UpdateProfile()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        var apiKey = await JS.InvokeAsync<string>("localStorage.getItem", "apiKey");
        var message = await ApiService.UpdateProfileAsync(user!, token, apiKey);
        await JS.InvokeVoidAsync("alert", message);
    }
}

<style>
    .form-group {
        margin-bottom: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .btn-primary {
        background: #007bff;
        color: white;
        padding: 0.5rem 1rem;
        border: none;
        cursor: pointer;
    }
    @@media (max-width: 768px) {
        .form-group

    {
        font-size: 0.9rem;
    }

    }
</style>