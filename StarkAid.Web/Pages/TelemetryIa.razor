@page "/admin/ia-telemetry"
@using StarkAid.Web.Services
@using System.Text.Json
@inject ApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="header-left">
        <h3>Telemetria de IA <small class="text-muted" style="font-size: 0.9rem;">(Real-time Insights)</small></h3>
        <span class="badge bg-primary">Analytics Pipeline</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData">
            <i class="bi bi-arrow-clockwise"></i> Atualizar
        </button>
    </div>
</div>

@if (overview == null)
{
    <div class="loading-container">
        <div class="spinner"></div>
        <p>Analisando dados de telemetria...</p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stats-card glass">
                <div class="stats-icon bg-blue-soft"><i class="bi bi-chat-dots"></i></div>
                <div class="stats-info">
                    <span class="stats-label">Total Interações</span>
                    <span class="stats-value">@overview.Value.GetProperty("totalInteracoes").GetInt32().ToString("N0")</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card glass">
                <div class="stats-icon bg-green-soft"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stats-info">
                    <span class="stats-label">Cache Hit Rate</span>
                    <span class="stats-value text-success">@overview.Value.GetProperty("cacheHitRate").GetDouble().ToString("F1") %</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card glass">
                <div class="stats-icon bg-purple-soft"><i class="bi bi-cpu"></i></div>
                <div class="stats-info">
                    <span class="stats-label">Tokens Evitados</span>
                    <span class="stats-value">@overview.Value.GetProperty("tokensEconomizados").GetInt32().ToString("N0")</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card glass highlight-green">
                <div class="stats-icon bg-yellow-soft"><i class="bi bi-currency-dollar"></i></div>
                <div class="stats-info">
                    <span class="stats-label">Economia Total</span>
                    <span class="stats-value text-success">$ @overview.Value.GetProperty("economiaUSD").GetDecimal().ToString("F2")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Qualidade do Cache -->
        <div class="col-md-6">
            <div class="dashboard-card h-100">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                    <h5 class="mb-0">Distribuição de Resultados</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-column gap-3">
                        @{
                            var totalInt = 0;
                            if (overview.Value.TryGetProperty("totalInteracoes", out var totalProp))
                                totalInt = totalProp.GetInt32();
                        }
                        @foreach (var item in qualityDistribution ?? new List<JsonElement>())
                        {
                            var count = item.GetProperty("count").GetInt32();
                            var perc = totalInt > 0 ? (count * 100.0) / totalInt : 0;
                            var label = item.GetProperty("resultado").GetString();
                            var colorClass = label switch {
                                "CacheHit_Exact" => "bg-success",
                                "CacheHit_FuzzyStrong" => "bg-info",
                                "CacheHit_FuzzyWeak" => "bg-warning",
                                _ => "bg-secondary"
                            };

                            <div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-500">@label</span>
                                    <span class="small text-muted">@count (@perc.ToString("F1")%)</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar @colorClass" style="width: @perc%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Latência e Performance -->
        <div class="col-md-6">
            <div class="dashboard-card h-100">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                    <h5 class="mb-0">Efetividade Fuzzy (Similarity)</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Resultado</th>
                                <th class="text-center">Média Score</th>
                                <th class="text-center">Min / Max</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in fuzzyAnalytics ?? new List<JsonElement>())
                            {
                                <tr>
                                    <td>@f.GetProperty("resultado").GetString()</td>
                                    <td class="text-center fw-bold">@f.GetProperty("averageScore").GetDouble().ToString("P1")</td>
                                    <td class="text-center text-muted small">
                                        @f.GetProperty("minScore").GetDouble().ToString("F2") - @f.GetProperty("maxScore").GetDouble().ToString("F2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="alert alert-light border mt-3 py-2 small">
                        <i class="bi bi-info-circle me-1"></i> A latência média do pipeline é de <strong>@overview.Value.GetProperty("latenciaMediaMs").GetDouble().ToString("N0") ms</strong>.
                    </div>
                </div>
            </div>
        </div>

        <!-- Onde o Cache Falha (Oportunidades) -->
        <div class="col-md-12">
            <div class="dashboard-card">
                <div class="card-header border-0 pt-3 px-3 d-flex justify-content-between">
                    <h5 class="mb-0">Top Cache Misses (Oportunidades de Aprendizado)</h5>
                    <span class="badge bg-warning text-dark">Treinamento Necessário</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3">Texto Normalizado</th>
                                    <th class="text-center">Ocorrências</th>
                                    <th class="text-end pe-3">Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var miss in topMisses ?? new List<JsonElement>())
                                {
                                    <tr>
                                        <td class="ps-3 fw-500">@miss.GetProperty("texto").GetString()</td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill bg-dark-soft text-primary-light border-0">@miss.GetProperty("ocorrencias").GetInt32() x</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <button class="btn btn-primary btn-sm py-0" @onclick='() => IrParaAprendizado(miss.GetProperty("texto").GetString()!)'>
                                                Criar Global
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (roiHistory != null)
    {
        <div class="row g-4 mt-2">
            <div class="col-md-12">
                <div class="dashboard-card pt-3 px-3 pb-2">
                    <h5 class="mb-3">Histórico de ROI (Últimos dias)</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th class="text-center">Cache Hits</th>
                                    <th class="text-end">Economia USD</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in roiHistory.Value.GetProperty("roi").EnumerateArray())
                                {
                                    <tr>
                                        <td>@day.GetProperty("date").GetDateTime().ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark">@day.GetProperty("hits").GetInt32() hits</span>
                                        </td>
                                        <td class="text-end fw-bold text-success">$ @day.GetProperty("economia").GetDecimal().ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private JsonElement? overview;
    private List<JsonElement>? qualityDistribution;
    private List<JsonElement>? topMisses;
    private List<JsonElement>? fuzzyAnalytics;
    private JsonElement? roiHistory;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        var apiKey = await JS.InvokeAsync<string>("localStorage.getItem", "apiKey");

        var ovRaw = await ApiService.GetTelemetryOverviewAsync(token, apiKey);
        if (ovRaw != null) overview = (JsonElement)ovRaw;

        var qdRaw = await ApiService.GetTelemetryQualityAsync(token, apiKey);
        if (qdRaw != null) qualityDistribution = ((JsonElement)qdRaw).EnumerateArray().ToList();

        var tmRaw = await ApiService.GetTopMissesAsync(token, apiKey);
        if (tmRaw != null) topMisses = ((JsonElement)tmRaw).EnumerateArray().ToList();

        var faRaw = await ApiService.GetFuzzyAnalyticsAsync(token, apiKey);
        if (faRaw != null) fuzzyAnalytics = ((JsonElement)faRaw).EnumerateArray().ToList();

        var roiRaw = await ApiService.GetRoiHistoryAsync(token, apiKey);
        if (roiRaw != null) roiHistory = (JsonElement)roiRaw;
    }

    private void IrParaAprendizado(string texto)
    {
        Navigation.NavigateTo($"/aprendizado-ia?prefill={Uri.EscapeDataString(texto)}");
    }
}

<style>
    /* Force dark background for the entire page container if needed */
    .telemetry-page {
        color: #e2e8f0;
    }

    .glass {
        background: rgba(30, 41, 59, 0.7) !important;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .dashboard-card {
        background: #1e293b !important; /* Solid dark background to ensure no bleed through */
        color: #f8fafc !important;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }
    
    .dashboard-card h5 {
        color: #38bdf8 !important; /* Cyan accent for headers */
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .table {
        color: #cbd5e1 !important;
        background-color: transparent !important;
    }

    .table thead th {
        color: #94a3b8 !important;
        background-color: rgba(15, 23, 42, 0.8) !important;
        border-bottom: 2px solid rgba(255, 255, 255, 0.05) !important;
        padding: 1rem;
    }

    .table tbody td {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 0.75rem 1rem;
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.03) !important;
    }

    .stats-card { padding: 1.25rem; border-radius: 12px; display: flex; align-items: center; gap: 1rem; }
    .stats-icon { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    
    .bg-blue-soft { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
    .bg-green-soft { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .bg-purple-soft { background: rgba(168, 85, 247, 0.15); color: #c084fc; }
    .bg-yellow-soft { background: rgba(234, 179, 8, 0.15); color: #fbbf24; }

    .stats-label { display: block; font-size: 0.75rem; color: #94a3b8 !important; font-weight: 500; }
    .stats-value { display: block; font-size: 1.25rem; font-weight: 700; color: #f8fafc !important; }
    
    .text-primary-light { color: #38bdf8 !important; }
    .bg-dark-soft { background-color: rgba(15, 23, 42, 0.6) !important; }

    .progress { background-color: rgba(15, 23, 42, 0.5) !important; height: 8px !important; }
    
    .loading-container { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 5rem; color: #94a3b8; }
    .spinner { width: 40px; height: 40px; border: 4px solid rgba(56, 189, 248, 0.1); border-top: 4px solid #38bdf8; border-radius: 50%; animation: spin 1s linear infinite; }
    @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>
