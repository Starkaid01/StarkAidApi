@page "/solutions/automacao"
@layout PublicLayout

<div class="product-hero">
    <div class="container">
        <div class="hero-badge">🏠 Automação Residencial</div>
        <h1 class="product-title">StarkAid <span class="gradient-text">Automação</span></h1>
        <p class="product-subtitle">
            Controle total da sua casa inteligente em uma única plataforma
        </p>
        <a href="/login" class="btn-primary-large">Comece Agora</a>
    </div>
</div>

<section class="product-features">
    <div class="container">
        <h2 class="section-title">Recursos Principais</h2>
        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">🔌</div>
                <h3>Controle de Dispositivos</h3>
                <p>Gerencie todos os seus dispositivos IoT em um só lugar</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">⏰</div>
                <h3>Agendamentos</h3>
                <p>Programe ações automáticas para seus dispositivos</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🎤</div>
                <h3>Comandos de Voz</h3>
                <p>Controle por voz via WhatsApp e assistentes virtuais</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">📊</div>
                <h3>Dashboard Intuitivo</h3>
                <p>Interface moderna e fácil de usar</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🔗</div>
                <h3>Integrações</h3>
                <p>Compatível com eWeLink, Tuya e mais</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">📱</div>
                <h3>Multi-Plataforma</h3>
                <p>Acesse de qualquer dispositivo</p>
            </div>
        </div>
    </div>
</section>

<section class="platforms-section">
    <div class="container">
        <h2 class="section-title">Plataformas Disponíveis</h2>
        
        <div class="platform-card">
            <div class="platform-header">
                <div class="platform-icon">📱</div>
                <h3>Aplicativo Android</h3>
            </div>
            <p>
                Aplicativo nativo desenvolvido em Kotlin com Material Design 3. 
                Controle completo de dispositivos, agendamentos e comandos de voz.
            </p>
            <div class="platform-features">
                <span class="tag">Kotlin</span>
                <span class="tag">Material Design</span>
                <span class="tag">Offline First</span>
            </div>
        </div>

        <div class="platform-card">
            <div class="platform-header">
                <div class="platform-icon">💻</div>
                <h3>Software Windows</h3>
            </div>
            <p>
                Aplicação desktop desenvolvida em WPF/Windows Forms com interface moderna. 
                Ideal para gerenciamento avançado e configurações detalhadas.
            </p>
            <div class="platform-features">
                <span class="tag">C#</span>
                <span class="tag">WPF</span>
                <span class="tag">Windows Forms</span>
            </div>
        </div>

        <div class="platform-card">
            <div class="platform-header">
                <div class="platform-icon">🌐</div>
                <h3>Plataforma Web</h3>
            </div>
            <p>
                Interface web responsiva desenvolvida em Blazor WebAssembly. 
                Acesse de qualquer navegador, em qualquer dispositivo.
            </p>
            <div class="platform-features">
                <span class="tag">Blazor</span>
                <span class="tag">WebAssembly</span>
                <span class="tag">PWA</span>
            </div>
        </div>
    </div>
</section>

<section class="docs-section">
    <div class="container">
        <h2 class="section-title">Documentação</h2>
        <div class="docs-grid">
            <a href="/docs/android" class="doc-card">
                <div class="doc-icon">📱</div>
                <h3>Aplicativo Android</h3>
                <p>Guia completo do app Kotlin</p>
            </a>
            <a href="/docs/windows" class="doc-card">
                <div class="doc-icon">💻</div>
                <h3>Software Windows</h3>
                <p>Manual do Windows Forms/WPF</p>
            </a>
            <a href="/docs/desenvolvedores" class="doc-card">
                <div class="doc-icon">👨‍💻</div>
                <h3>API para Desenvolvedores</h3>
                <p>Integre com nossa API REST</p>
            </a>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <h2>Pronto para começar?</h2>
        <p>Crie sua conta gratuitamente e comece a automatizar sua casa hoje mesmo</p>
        <a href="/login" class="btn-primary-large">Criar Conta Grátis</a>
    </div>
</section>

