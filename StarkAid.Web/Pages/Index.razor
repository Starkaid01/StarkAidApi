@page "/"
@layout PublicLayout

<div class="hero-section">
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">
                Transformando Ideias em
                <span class="gradient-text">Realidade Digital</span>
            </h1>
            <p class="hero-subtitle">
                Desenvolvemos soluções completas mobile, web e desktop com tecnologia de ponta
            </p>
            <div class="hero-buttons">
                <a href="/contato" class="btn-primary">Contate-nos Agora!</a>
                <a href="/solutions" class="btn-secondary">Nossas Soluções</a>
            </div>
        </div>
        <div class="hero-visual">
            <div class="floating-card card-1">
                <div class="card-icon">📱</div>
                <div class="card-text">Mobile</div>
            </div>
            <div class="floating-card card-2">
                <div class="card-icon">🌐</div>
                <div class="card-text">Web</div>
            </div>
            <div class="floating-card card-3">
                <div class="card-icon">💻</div>
                <div class="card-text">Desktop</div>
            </div>
            <div class="floating-card card-4">
                <div class="card-icon">🏠</div>
                <div class="card-text">Automação</div>
            </div>
        </div>
    </div>
</div>

<section class="solutions-preview">
    <div class="container">
        <h2 class="section-title">Nossas Soluções</h2>
        <div class="solutions-grid">
            <div class="solution-card">
                <div class="solution-icon">📱</div>
                <h3>Mobile</h3>
                <p>Aplicativos nativos e multiplataforma para iOS e Android</p>
            </div>
            <div class="solution-card">
                <div class="solution-icon">🌐</div>
                <h3>Web</h3>
                <p>Sistemas web modernos, responsivos e de alta performance</p>
            </div>
            <div class="solution-card">
                <div class="solution-icon">💻</div>
                <h3>Desktop</h3>
                <p>Aplicações desktop robustas para Windows, macOS e Linux</p>
            </div>
            <div class="solution-card">
                <div class="solution-icon">🏠</div>
                <h3>Automação</h3>
                <p>Soluções inteligentes de automação residencial e empresarial</p>
            </div>
        </div>
    </div>
</section>

<section class="tech-stack">
    <div class="container">
        <h2 class="section-title">Tecnologias de Ponta</h2>
        <div class="tech-grid">
            <div class="tech-item">C#</div>
            <div class="tech-item">Blazor</div>
            <div class="tech-item">ASP.NET Core</div>
            <div class="tech-item">Kotlin</div>
            <div class="tech-item">Android</div>
            <div class="tech-item">WPF</div>
            <div class="tech-item">SQL Server</div>
            <div class="tech-item">Azure</div>
        </div>
    </div>
</section>

<section class="about-section">
    <div class="container">
        <div class="about-content">
            <h2>Sobre a StarkAid</h2>
            <p>
                Somos uma startup de desenvolvimento focada em criar soluções completas e inovadoras. 
                Nossa missão é transformar ideias em produtos digitais de alta qualidade.
            </p>
            <p>
                Com experiência em desenvolvimento mobile, web e desktop, oferecemos soluções 
                end-to-end que atendem às necessidades específicas de cada cliente.
            </p>
        </div>
    </div>
</section>

