@inherits LayoutComponentBase

<div class="app-container">
    <NavMenu />
    <div class="main-content">
        <div class="content px-4 py-3">
            @Body
        </div>
    </div>
</div>

<style>
    .app-container {
        display: flex;
        min-height: 100vh;
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #f9fafb; /* fundo claro para conteúdo */
    }

    .content {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
    }

    @@media (max-width: 768px) {
        .app-container

    {
        flex-direction: column;
    }

    .nav-menu {
        width: 100% !important;
        height: auto;
    }

    }
</style>